---
import CodeBackgroundCanvas from './CodeBackgroundCanvas.astro';
---

<section class="pt-16 md:pt-24 pb-12 md:pb-20 relative overflow-hidden">
  <CodeBackgroundCanvas />
  <div class="w-full max-w-6xl mx-auto px-6 relative z-10">
    <div class="max-w-3xl mx-auto">
      <img src="/images/headshot.png" alt="Jesse Peplinski" class="w-32 h-32 rounded-full mb-6 border-2 border-[var(--color-surface-border)] mx-auto" />
      <p class="text-sm font-medium text-[var(--color-brand-orange)] mb-4 tracking-wide uppercase">Software Engineer</p>
      <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
        Hi, I'm <span class="gradient-text">Jesse</span>.
      </h1>
      <p class="text-xl md:text-2xl text-[var(--color-text-secondary)] mb-8 leading-relaxed">
        I help Central NY's small businesses <span class="gradient-text">solve problems</span>.
      </p>

      <div class="flex items-center gap-5">
        <a href="mailto:peplinski.jesse@gmail.com" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors" aria-label="Email">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
        <a href="#" class="qrcode-toggle text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors" aria-label="QR Code">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="3"></rect><rect x="14" y="7" width="3" height="3"></rect><rect x="7" y="14" width="3" height="3"></rect><rect x="14" y="14" width="3" height="3"></rect></svg>
        </a>
      </div>
    </div>
  </div>
</section>
