---
import { mission } from '../data/site-content';
---

<section id="mission" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-8">My Mission</h2>
      {mission.map((paragraph) => (
        <p class="text-lg text-[var(--color-text-secondary)] mb-6">{paragraph}</p>
      ))}
    </div>
  </div>
</section>
