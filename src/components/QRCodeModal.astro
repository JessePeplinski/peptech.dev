---
---

<div id="qrcode-container" class="fixed inset-0 bg-black/70 flex items-center justify-center z-50 opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="business-card" class="bg-[var(--color-surface-raised)] p-6 rounded-lg shadow-xl transform transition-transform duration-300 scale-90 max-w-md w-full mx-4">
    <div class="flex justify-end mb-2">
      <button id="qrcode-close" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-transform duration-200 hover:rotate-90 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="flex justify-center">
      <div class="qr-code-wrapper relative p-2.5">
        <div class="qr-code-frame relative p-4 bg-white rounded-xl shadow-lg overflow-hidden border-3 border-transparent">
          <img src="/images/qrcode.png" alt="QR Code for peptech.dev" class="w-64 h-64 object-contain">
          <div class="scan-line absolute top-0 left-0 right-0 h-[3px] opacity-0 -translate-y-2.5"></div>
        </div>
      </div>
    </div>
    <div class="mt-4 text-center">
      <h3 class="text-3xl font-bold"><span class="gradient-text">Pep Tech</span></h3>
      <p class="text-[var(--color-text-secondary)] text-lg mt-2">Business Solutions</p>
      <p class="text-[var(--color-text-muted)] text-sm mt-2">I help small businesses solve core problems</p>
    </div>
  </div>
</div>

<script>
  function initQRCode() {
    const toggles = document.querySelectorAll('.qrcode-toggle');
    const container = document.getElementById('qrcode-container');
    const close = document.getElementById('qrcode-close');

    if (!toggles.length || !container || !close) return;

    setTimeout(() => {
      toggles.forEach(t => t.classList.add('qr-pulse'));
      setTimeout(() => toggles.forEach(t => t.classList.remove('qr-pulse')), 6000);
    }, 3000);

    toggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        container.classList.add('qrcode-visible');
      });
    });

    close.addEventListener('click', () => {
      container.classList.remove('qrcode-visible');
    });

    container.addEventListener('click', (e) => {
      if (e.target === container) {
        container.classList.remove('qrcode-visible');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && container.classList.contains('qrcode-visible')) {
        container.classList.remove('qrcode-visible');
      }
    });
  }

  initQRCode();
</script>
