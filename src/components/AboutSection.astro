---
import { aboutMe, values } from '../data/site-content';

const paragraphs = aboutMe.slice(0, -1);
const valuesLeadIn = aboutMe[aboutMe.length - 1];
---

<section id="about" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">About Me</h2>
      {paragraphs.map((paragraph) => (
        <p class="text-lg text-[var(--color-text-secondary)] mb-6">{paragraph}</p>
      ))}
      <p class="text-lg text-[var(--color-text-secondary)] mb-4">{valuesLeadIn}</p>
      <ul class="space-y-3 mb-6">
        {values.map((value) => (
          <li class="text-lg text-[var(--color-text-secondary)]">
            <span class="font-semibold text-[var(--color-text-primary)]">{value.title}</span> — {value.description}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
