---
import { timelinePhases, supportPhase } from '../data/site-content';

const iconPaths: Record<string, string> = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  check: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  sparkle: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  support: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
};
---

<section id="timeline" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-8">Project Timeline</h2>
    <p class="text-[var(--color-text-secondary)] max-w-2xl mb-12">
      From initial consultation to launch and beyond, here's how we'll work together to bring your project to life.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {timelinePhases.map((phase) => (
        <div class="bg-[var(--color-surface)] rounded-lg p-6 shadow-md border border-[var(--color-surface-border)] relative card-hover">
          <div class="absolute -top-4 left-6 flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] text-white font-bold shadow-md">
            {phase.number}
          </div>
          <div class="flex flex-col h-full">
            <div class="mb-4 mt-2">
              <div class="flex items-center">
                <svg class="h-6 w-6 text-[var(--color-brand-orange)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[phase.icon]} />
                </svg>
                <h3 class="text-xl font-bold ml-2">{phase.title}</h3>
              </div>
              <div class="bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] h-1 w-16 mt-2 rounded-full"></div>
            </div>
            <p class="text-[var(--color-text-secondary)] flex-grow">{phase.description}</p>
            <div class="mt-4 pt-3 border-t border-[var(--color-surface-border)]">
              <span class="text-sm font-medium bg-[var(--color-brand-orange)]/10 text-[var(--color-brand-orange)] py-1 px-2 rounded-full">{phase.duration}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Support phase -->
    <div class="mt-12 bg-[var(--color-surface)] rounded-lg p-6 shadow-md border border-[var(--color-surface-border)] card-hover relative max-w-3xl mx-auto">
      <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] text-white font-bold shadow-md">
        5
      </div>
      <div class="flex flex-col md:flex-row md:items-center mt-2">
        <div class="md:w-1/3 mb-4 md:mb-0">
          <div class="flex items-center justify-center md:justify-start">
            <svg class="h-6 w-6 text-[var(--color-brand-orange)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.support} />
            </svg>
            <h3 class="text-xl font-bold ml-2">{supportPhase.title}</h3>
          </div>
          <div class="bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] h-1 w-16 mt-2 mx-auto md:mx-0 rounded-full"></div>
        </div>
        <div class="md:w-2/3 md:pl-6 text-[var(--color-text-secondary)] md:border-l md:border-[var(--color-surface-border)]">
          <p>{supportPhase.description}</p>
          <div class="mt-3">
            <span class="text-sm font-medium bg-[var(--color-brand-orange)]/10 text-[var(--color-brand-orange)] py-1 px-2 rounded-full">{supportPhase.duration}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
