---
---

<section id="intake" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 text-center">Get Started</h2>
    <p class="text-[var(--color-text-secondary)] mb-8 max-w-3xl mx-auto text-center">
      Answer a few questions and I'll give you an estimate. No commitment — just clarity on what it costs.
    </p>

    <!-- Step indicators -->
    <div class="max-w-2xl mx-auto mb-10">
      <div class="flex items-center justify-between">
        <button type="button" data-step-nav="1" class="step-indicator flex-1 text-center cursor-pointer group">
          <div class="flex items-center justify-center mb-2">
            <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-brand-orange)] bg-[var(--color-brand-orange)] text-white transition-colors">1</div>
          </div>
          <span class="text-xs font-medium text-[var(--color-brand-orange)] transition-colors">Your Needs</span>
        </button>
        <div class="flex-shrink-0 w-12 h-px bg-[var(--color-surface-border)] -mt-5"></div>
        <button type="button" data-step-nav="2" class="step-indicator flex-1 text-center cursor-pointer group">
          <div class="flex items-center justify-center mb-2">
            <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-surface-border)] text-[var(--color-text-muted)] transition-colors">2</div>
          </div>
          <span class="text-xs font-medium text-[var(--color-text-muted)] transition-colors">Monthly Plan</span>
        </button>
        <div class="flex-shrink-0 w-12 h-px bg-[var(--color-surface-border)] -mt-5"></div>
        <button type="button" data-step-nav="3" class="step-indicator flex-1 text-center cursor-pointer group">
          <div class="flex items-center justify-center mb-2">
            <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-surface-border)] text-[var(--color-text-muted)] transition-colors">3</div>
          </div>
          <span class="text-xs font-medium text-[var(--color-text-muted)] transition-colors">Your Business</span>
        </button>
        <div class="flex-shrink-0 w-12 h-px bg-[var(--color-surface-border)] -mt-5"></div>
        <button type="button" data-step-nav="4" class="step-indicator flex-1 text-center cursor-pointer group">
          <div class="flex items-center justify-center mb-2">
            <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-surface-border)] text-[var(--color-text-muted)] transition-colors">4</div>
          </div>
          <span class="text-xs font-medium text-[var(--color-text-muted)] transition-colors">Review</span>
        </button>
      </div>
    </div>

    <!-- Running estimate -->
    <div id="running-estimate" class="max-w-2xl mx-auto mb-8 bg-[var(--color-surface)] rounded-lg p-4 border border-[var(--color-surface-border)] text-center">
      <p class="text-sm text-[var(--color-text-muted)] mb-1">Your estimate</p>
      <p id="estimate-empty" class="text-sm text-[var(--color-text-muted)]">Select a service above to see your estimate</p>
      <div id="estimate-details" class="hidden">
        <p class="text-lg font-bold">
          <span id="estimate-onetime" class="gradient-text">$0</span>
          <span class="text-[var(--color-text-muted)]"> one-time</span>
          <span class="text-[var(--color-text-muted)]"> + </span>
          <span id="estimate-monthly" class="gradient-text">$0/mo</span>
        </p>
        <p id="estimate-breakdown" class="text-xs text-[var(--color-text-muted)] mt-1"></p>
      </div>
    </div>

    <form id="stepper-form" class="max-w-2xl mx-auto">

      <!-- STEP 1: What do you need? -->
      <div id="step-1" class="step">
        <h3 class="text-xl font-bold mb-2">What do you need?</h3>
        <p class="text-sm text-[var(--color-text-muted)] mb-6">Select all that apply.</p>
        <div class="space-y-4 mb-6">
          <label class="service-option flex items-start gap-4 p-4 rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface)] cursor-pointer hover:border-[var(--color-brand-orange)]/50 transition-colors">
            <input type="checkbox" name="service" value="website" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-semibold text-lg">Website</span>
              <p class="text-sm text-[var(--color-text-secondary)]">A professional marketing site — your digital front door</p>
              <p class="text-sm font-medium text-[var(--color-brand-orange)] mt-1">Starting at $3,000</p>
            </div>
          </label>
          <label class="service-option flex items-start gap-4 p-4 rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface)] cursor-pointer hover:border-[var(--color-brand-orange)]/50 transition-colors">
            <input type="checkbox" name="service" value="custom-app" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-semibold text-lg">Custom App</span>
              <p class="text-sm text-[var(--color-text-secondary)]">A custom application to solve a specific business problem</p>
              <p class="text-sm font-medium text-[var(--color-brand-orange)] mt-1">Starting at $7,500</p>
            </div>
          </label>
          <label class="service-option flex items-start gap-4 p-4 rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface)] cursor-pointer hover:border-[var(--color-brand-orange)]/50 transition-colors">
            <input type="checkbox" name="service" value="mobile-app" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-semibold text-lg">Mobile App</span>
              <p class="text-sm text-[var(--color-text-secondary)]">A native or cross-platform app for your customers and team</p>
              <p class="text-sm font-medium text-[var(--color-brand-orange)] mt-1">Let's talk</p>
            </div>
          </label>
          <label class="service-option flex items-start gap-4 p-4 rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface)] cursor-pointer hover:border-[var(--color-brand-orange)]/50 transition-colors">
            <input type="checkbox" name="service" value="marketing" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-semibold text-lg">Marketing</span>
              <p class="text-sm text-[var(--color-text-secondary)]">Social media, Google Ads, email newsletters, and more</p>
              <p class="text-sm font-medium text-[var(--color-brand-orange)] mt-1">$300/mo</p>
            </div>
          </label>
        </div>
      </div>

      <!-- STEP 2: Choose your plan -->
      <div id="step-2" class="step hidden">
        <h3 class="text-xl font-bold mb-2">Choose a monthly plan</h3>
        <p class="text-sm text-[var(--color-text-muted)] mb-6">This covers hosting, maintenance, and ongoing support.</p>
        <div id="plan-options" class="space-y-4">
          <!-- Populated by JS based on service selection -->
        </div>
      </div>

      <!-- STEP 3: Your details -->
      <div id="step-3" class="step hidden">
        <h3 class="text-xl font-bold mb-2">Tell me about your business</h3>
        <p class="text-sm text-[var(--color-text-muted)] mb-6">The more detail you share, the better I can help.</p>
        <div class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="s-name" class="block text-sm font-medium mb-2">Name <span class="text-[var(--color-brand-orange)]">*</span></label>
              <input type="text" id="s-name" name="name" required class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors" placeholder="John Smith" />
            </div>
            <div>
              <label for="s-email" class="block text-sm font-medium mb-2">Email <span class="text-[var(--color-brand-orange)]">*</span></label>
              <input type="email" id="s-email" name="email" required class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors" placeholder="john@example.com" />
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="s-phone" class="block text-sm font-medium mb-2">Phone</label>
              <input type="tel" id="s-phone" name="phone" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors" placeholder="(315) 555-1234" />
            </div>
            <div>
              <label for="s-website" class="block text-sm font-medium mb-2">Website <span class="text-[var(--color-text-muted)] text-xs">(if you have one)</span></label>
              <input type="url" id="s-website" name="website" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors" placeholder="https://yourbusiness.com" />
            </div>
          </div>
          <div>
            <label for="s-hosting" class="block text-sm font-medium mb-2">Where is your site hosted? <span class="text-[var(--color-text-muted)] text-xs">(if applicable)</span></label>
            <select id="s-hosting" name="hosting" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors cursor-pointer">
              <option value="">Select a provider</option>
              <option value="godaddy">GoDaddy</option>
              <option value="squarespace">Squarespace</option>
              <option value="wix">Wix</option>
              <option value="wordpress">WordPress.com</option>
              <option value="shopify">Shopify</option>
              <option value="none">I don't have a website yet</option>
              <option value="not-sure">Not sure</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="s-description" class="block text-sm font-medium mb-2">Briefly describe your business <span class="text-[var(--color-brand-orange)]">*</span></label>
            <textarea id="s-description" name="description" required rows="4" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y" placeholder="What does your business do? Who are your customers?"></textarea>
          </div>
          <div>
            <label for="s-problems" class="block text-sm font-medium mb-2">What problems are you trying to solve? <span class="text-[var(--color-brand-orange)]">*</span></label>
            <textarea id="s-problems" name="problems" required rows="4" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y" placeholder="What's slowing your business down? What do you wish technology could solve?"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Preferred contact method</label>
            <div class="flex gap-4">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="contact-method" value="email" checked class="accent-[var(--color-brand-orange)] cursor-pointer" />
                <span>Email</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="contact-method" value="phone" class="accent-[var(--color-brand-orange)] cursor-pointer" />
                <span>Phone</span>
              </label>
            </div>
          </div>
          <div>
            <label for="s-referral" class="block text-sm font-medium mb-2">How did you hear about me?</label>
            <select id="s-referral" name="referral" class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors cursor-pointer">
              <option value="">Select an option</option>
              <option value="google">Google</option>
              <option value="referral">Referral / Word of mouth</option>
              <option value="social-media">Social media</option>
              <option value="linkedin">LinkedIn</option>
              <option value="saw-my-work">Saw a website I built</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
      </div>

      <!-- STEP 4: Summary -->
      <div id="step-4" class="step hidden">
        <h3 class="text-xl font-bold mb-6">Review your estimate</h3>

        <div class="bg-[var(--color-surface)] rounded-lg border border-[var(--color-surface-border)] overflow-hidden mb-6">
          <div id="summary-items" class="p-6 space-y-4">
            <!-- Populated by JS -->
          </div>
          <div class="bg-[var(--color-surface-raised)] p-6 border-t border-[var(--color-surface-border)]">
            <div class="flex justify-between items-center mb-2">
              <span class="font-bold text-lg">Estimated total</span>
              <div class="text-right">
                <span class="font-bold text-lg gradient-text" id="summary-total-onetime">$0</span>
                <span class="text-[var(--color-text-muted)]"> one-time</span>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span></span>
              <div class="text-right">
                <span class="font-bold text-lg gradient-text" id="summary-total-monthly">$0/mo</span>
                <span class="text-[var(--color-text-muted)]"> monthly</span>
              </div>
            </div>
          </div>
        </div>

        <p class="text-sm text-[var(--color-text-muted)] text-center mb-6">
          This is an estimate — we'll confirm the details together. No surprises. You should expect a response from me within 24 hours.
        </p>
      </div>

      <!-- Navigation buttons -->
      <div class="flex justify-between items-center mt-8">
        <button type="button" id="btn-back" class="btn-outline hidden cursor-pointer">
          Back
        </button>
        <div class="flex-1"></div>
        <button type="button" id="btn-next" class="btn-gradient cursor-pointer">
          Next
        </button>
        <button type="submit" id="btn-submit" class="btn-gradient cursor-pointer" style="display:none">
          Submit
        </button>
      </div>

      <p class="text-center text-sm text-[var(--color-text-muted)] mt-4">
        Prefer email? Reach me at <a href="mailto:peplinski.jesse@gmail.com" class="text-[var(--color-brand-orange)] underline hover:brightness-125 transition-all">peplinski.jesse@gmail.com</a>
      </p>
    </form>

    <!-- Success message -->
    <div id="stepper-success" class="hidden text-center py-12 max-w-2xl mx-auto">
      <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-green-500/10 text-green-400 mb-4">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold mb-2">Thanks!</h3>
      <p class="text-[var(--color-text-secondary)]">I'll review your submission and get back to you within 48 hours.</p>
    </div>
  </div>
</section>

<script>
  let currentStep = 1;

  interface Plan { name: string; price: number; label: string; features: string[] }
  interface ServicePricing { onetime: number; onetimeLabel: string; serviceName: string; plans: Plan[] }

  const pricing: Record<string, ServicePricing> = {
    'website': {
      onetime: 3000, onetimeLabel: '$3,000', serviceName: 'Website',
      plans: [
        { name: 'Essentials', price: 50, label: '$50/mo', features: ['Hosting & uptime monitoring', 'Security updates & patches', 'Content updates available at $150/hr', 'Email support'] },
        { name: 'Growth', price: 150, label: '$150/mo', features: ['Everything in Essentials', 'Unlimited content updates', 'Monthly analytics, SEO, and GEO report', 'Performance optimization'] },
      ]
    },
    'custom-app': {
      onetime: 7500, onetimeLabel: '$7,500+', serviceName: 'Custom App',
      plans: [
        { name: 'Essentials', price: 150, label: '$150/mo', features: ['Hosting & uptime monitoring', 'Security updates & patches', 'Database maintenance & backups', 'Bug fixes for existing functionality', 'Email support'] },
        { name: 'Growth', price: 300, label: '$300/mo', features: ['Everything in Essentials', 'Monthly analytics & performance report', 'Monthly 30-minute strategy call'] },
      ]
    },
    'mobile-app': {
      onetime: 0, onetimeLabel: 'Custom quote', serviceName: 'Mobile App',
      plans: [
        { name: 'Essentials', price: 150, label: '$150/mo', features: ['Hosting & uptime monitoring', 'Security updates & patches', 'Bug fixes for existing functionality', 'Email support'] },
        { name: 'Growth', price: 300, label: '$300/mo', features: ['Everything in Essentials', 'Monthly analytics & performance report', 'Monthly 30-minute strategy call'] },
      ]
    },
    'marketing': {
      onetime: 0, onetimeLabel: '$0', serviceName: 'Marketing',
      plans: [] // No monthly plan selection needed — flat $300/mo
    },
  };

  function getSelectedServices(): string[] {
    return Array.from(document.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')).map(el => el.value);
  }

  function getSelectedPlanFor(service: string): string {
    return (document.querySelector<HTMLInputElement>(`input[name="plan-${service}"]:checked`))?.value || '';
  }

  function hasMarketing(): boolean {
    return getSelectedServices().includes('marketing');
  }

  function getEstimate() {
    const services = getSelectedServices();

    let totalOnetime = 0;
    let hasCustomQuote = false;
    let totalMonthly = 0;
    const parts: string[] = [];

    for (const svc of services) {
      const p = pricing[svc];
      if (!p) continue;

      if (svc === 'marketing') {
        totalMonthly += 300;
        parts.push('Marketing ($300/mo)');
        continue;
      }

      if (p.onetime > 0) {
        totalOnetime += p.onetime;
        parts.push(`${p.serviceName} (${p.onetimeLabel})`);
      } else {
        hasCustomQuote = true;
        parts.push(`${p.serviceName} (Custom quote)`);
      }
      const planName = getSelectedPlanFor(svc);
      const selectedPlan = p.plans.find(pl => pl.name === planName);
      if (selectedPlan) totalMonthly += selectedPlan.price;
    }

    const onetimeLabel = hasCustomQuote && totalOnetime === 0 ? 'Custom quote' :
                         hasCustomQuote ? `$${totalOnetime.toLocaleString()}+` :
                         `$${totalOnetime.toLocaleString()}`;

    return { onetime: totalOnetime, onetimeLabel, monthly: totalMonthly, monthlyLabel: `$${totalMonthly}/mo`, breakdown: parts.join(' + '), hasCustomQuote };
  }

  function updateEstimate() {
    const est = getEstimate();
    const services = getSelectedServices();
    const empty = document.getElementById('estimate-empty')!;
    const details = document.getElementById('estimate-details')!;

    if (services.length === 0) {
      empty.classList.remove('hidden');
      details.classList.add('hidden');
      return;
    }

    empty.classList.add('hidden');
    details.classList.remove('hidden');
    document.getElementById('estimate-onetime')!.textContent = est.onetimeLabel;
    document.getElementById('estimate-monthly')!.textContent = est.monthlyLabel;
    document.getElementById('estimate-breakdown')!.textContent = est.breakdown;
  }

  function updateSummary() {
    const services = getSelectedServices();
    const est = getEstimate();

    const container = document.getElementById('summary-items')!;
    let html = '';

    for (const svc of services) {
      const p = pricing[svc];
      if (!p) continue;

      if (svc === 'marketing') {
        html += '<div class="flex justify-between items-center"><span class="text-[var(--color-text-secondary)]">Marketing</span><span class="font-semibold">$300/mo</span></div>';
        html += '<div class="border-t border-[var(--color-surface-border)]"></div>';
        continue;
      }

      html += `<div class="flex justify-between items-center"><span class="text-[var(--color-text-secondary)]">${p.serviceName} Build</span><span class="font-semibold">${p.onetimeLabel}</span></div>`;
      html += '<div class="border-t border-[var(--color-surface-border)]"></div>';

      const planName = getSelectedPlanFor(svc);
      const selectedPlan = p.plans.find(pl => pl.name === planName);
      if (selectedPlan) {
        html += `<div class="flex justify-between items-center"><span class="text-[var(--color-text-secondary)]">${p.serviceName} — ${selectedPlan.name}</span><span class="font-semibold">${selectedPlan.label}</span></div>`;
        html += '<div class="border-t border-[var(--color-surface-border)]"></div>';
      }
    }

    container.innerHTML = html;
    document.getElementById('summary-total-onetime')!.textContent = est.onetimeLabel;
    document.getElementById('summary-total-monthly')!.textContent = est.monthlyLabel;
  }

  function renderPlanGroup(svc: string, p: ServicePricing): string {
    return `
      <div class="mb-8">
        <h4 class="text-lg font-semibold mb-4">${p.serviceName} — Monthly Plan</h4>
        <div class="space-y-4">
          ${p.plans.map((plan, i) => `
            <label class="plan-option flex items-start gap-4 p-4 rounded-lg border border-[var(--color-surface-border)] bg-[var(--color-surface)] cursor-pointer hover:border-[var(--color-brand-orange)]/50 transition-colors">
              <input type="radio" name="plan-${svc}" value="${plan.name}" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-lg">${plan.name}</span>
                  ${i === p.plans.length - 1 ? '<span class="text-xs bg-[var(--color-brand-orange)] text-white px-2 py-0.5 rounded-full font-bold">RECOMMENDED</span>' : ''}
                </div>
                <p class="text-lg font-bold gradient-text mt-1">${plan.label}</p>
                <ul class="mt-3 space-y-1.5">
                  ${plan.features.map(f => `<li class="flex items-start text-sm text-[var(--color-text-secondary)]"><svg class="h-4 w-4 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>${f}</li>`).join('')}
                </ul>
              </div>
            </label>
          `).join('')}
        </div>
      </div>
    `;
  }

  function populatePlans() {
    const services = getSelectedServices().filter(svc => svc !== 'marketing');
    const container = document.getElementById('plan-options')!;

    if (services.length === 0) {
      container.innerHTML = '<p class="text-[var(--color-text-muted)] text-center py-4">No services selected that require a monthly plan. Click Next to continue.</p>';
      return;
    }

    container.innerHTML = services.map(svc => {
      const p = pricing[svc];
      return p ? renderPlanGroup(svc, p) : '';
    }).join('');

    // Plan selection listeners — highlight and update estimate
    container.querySelectorAll('.plan-option').forEach(label => {
      const input = label.querySelector('input') as HTMLInputElement;
      input.addEventListener('change', () => {
        // Only clear highlights within the same radio group
        const groupName = input.name;
        container.querySelectorAll(`input[name="${groupName}"]`).forEach(r => {
          (r as HTMLElement).closest('.plan-option')?.classList.remove('border-[var(--color-brand-orange)]');
        });
        label.classList.add('border-[var(--color-brand-orange)]');
        updateEstimate();
      });
    });

    updateEstimate();
  }

  function updateStepIndicators() {
    document.querySelectorAll('.step-indicator').forEach(indicator => {
      const step = parseInt(indicator.getAttribute('data-step-nav')!);
      const dot = indicator.querySelector('.step-dot')!;
      const label = indicator.querySelector('span:last-child')!;

      if (step < currentStep) {
        // Completed
        dot.className = 'step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-green-500 bg-green-500 text-white transition-colors';
        dot.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
        label.className = 'text-xs font-medium text-green-500 transition-colors';
      } else if (step === currentStep) {
        // Active
        dot.className = 'step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-brand-orange)] bg-[var(--color-brand-orange)] text-white transition-colors';
        dot.textContent = String(step);
        label.className = 'text-xs font-medium text-[var(--color-brand-orange)] transition-colors';
      } else {
        // Future
        dot.className = 'step-dot w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 border-[var(--color-surface-border)] text-[var(--color-text-muted)] transition-colors';
        dot.textContent = String(step);
        label.className = 'text-xs font-medium text-[var(--color-text-muted)] transition-colors';
      }
    });
  }

  function goToStep(step: number) {
    currentStep = step;

    // Show/hide steps
    document.querySelectorAll('.step').forEach(el => el.classList.add('hidden'));
    document.getElementById(`step-${step}`)!.classList.remove('hidden');

    // Update step indicators
    updateStepIndicators();

    // Show/hide buttons
    document.getElementById('btn-back')!.classList.toggle('hidden', step === 1);
    document.getElementById('btn-next')!.style.display = step === 4 ? 'none' : '';
    document.getElementById('btn-submit')!.style.display = step === 4 ? '' : 'none';

    // Step-specific logic
    if (step === 2) populatePlans();
    if (step === 4) updateSummary();

    document.getElementById('intake')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Highlight selected service options
  document.querySelectorAll('.service-option').forEach(label => {
    const input = label.querySelector('input') as HTMLInputElement;
    input.addEventListener('change', () => {
      label.classList.toggle('border-[var(--color-brand-orange)]', input.checked);
      updateEstimate();
    });
  });

  // Step nav clicks (only go back to completed steps)
  document.querySelectorAll('[data-step-nav]').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = parseInt(btn.getAttribute('data-step-nav')!);
      if (target < currentStep) goToStep(target);
    });
  });

  // Next button
  document.getElementById('btn-next')?.addEventListener('click', () => {
    if (currentStep === 1 && getSelectedServices().length === 0) {
      document.querySelectorAll('.service-option').forEach(l => {
        l.classList.add('border-red-400/50');
        setTimeout(() => l.classList.remove('border-red-400/50'), 2000);
      });
      return;
    }
    if (currentStep === 2) {
      // Validate all services (except marketing) have a plan selected
      const services = getSelectedServices().filter(svc => svc !== 'marketing');
      let allSelected = true;
      for (const svc of services) {
        if (!getSelectedPlanFor(svc)) {
          allSelected = false;
          // Highlight unselected group
          document.querySelectorAll(`input[name="plan-${svc}"]`).forEach(input => {
            const label = (input as HTMLElement).closest('.plan-option');
            label?.classList.add('border-red-400/50');
            setTimeout(() => label?.classList.remove('border-red-400/50'), 2000);
          });
        }
      }
      if (!allSelected) return;
    }
    if (currentStep < 4) goToStep(currentStep + 1);
  });

  // Back button
  document.getElementById('btn-back')?.addEventListener('click', () => {
    if (currentStep > 1) goToStep(currentStep - 1);
  });

  // Submit (only on step 4)
  document.getElementById('stepper-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (currentStep !== 4) return;
    // TODO: Wire up to backend
    document.getElementById('stepper-form')!.classList.add('hidden');
    document.getElementById('running-estimate')!.classList.add('hidden');
    document.querySelectorAll('.step-indicator').forEach(el => (el as HTMLElement).style.display = 'none');
    document.getElementById('stepper-success')!.classList.remove('hidden');
  });
</script>
