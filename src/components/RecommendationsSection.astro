<section id="recommendations" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 text-center">What People Say</h2>
    <p class="text-[var(--color-text-secondary)] mb-12 max-w-3xl mx-auto text-center">
      Here's what colleagues and collaborators are saying about me on <a href="https://linkedin.com/in/jessepeplinski" target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand-orange)] underline hover:brightness-125 transition-all">LinkedIn</a>.
    </p>

    <div class="relative">
      <!-- Carousel container -->
      <div id="carousel" class="overflow-hidden">
        <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out">
          {recommendations.map((rec) => (
            <div class="carousel-slide flex-shrink-0 w-full md:w-1/3 px-4">
              <div class="bg-[var(--color-surface-raised)] rounded-lg p-6 border border-[var(--color-surface-border)] h-full flex flex-col">
                <svg class="w-8 h-8 text-[var(--color-brand-orange)] mb-4 opacity-50 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
                <p class="text-[var(--color-text-secondary)] mb-6 leading-relaxed flex-1" set:html={rec.quote} />
                <div>
                  <p class="font-semibold text-sm">{rec.name}</p>
                  <p class="text-xs text-[var(--color-text-muted)]">{rec.title} · {rec.date}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation arrows -->
      <button id="carousel-prev" class="absolute top-1/2 -left-4 -translate-y-1/2 w-10 h-10 rounded-full bg-[var(--color-surface)] border border-[var(--color-surface-border)] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-brand-orange)] transition-colors cursor-pointer shadow-lg" aria-label="Previous">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button id="carousel-next" class="absolute top-1/2 -right-4 -translate-y-1/2 w-10 h-10 rounded-full bg-[var(--color-surface)] border border-[var(--color-surface-border)] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-brand-orange)] transition-colors cursor-pointer shadow-lg" aria-label="Next">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div id="carousel-dots" class="flex justify-center gap-2 mt-8">
    </div>

    <div class="text-center mt-6">
      <a href="https://jessepeplinski.com/recommendations" target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand-orange)] font-medium hover:brightness-125 transition-all">
        See full recommendations &rarr;
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const slides = document.querySelectorAll('.carousel-slide');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const dotsContainer = document.getElementById('carousel-dots')!;

  let currentIndex = 0;
  let slidesPerView = 3;
  let totalPages = 1;
  let autoplayInterval: ReturnType<typeof setInterval>;

  function updateSlidesPerView() {
    if (window.innerWidth < 768) {
      slidesPerView = 1;
    } else {
      slidesPerView = 3;
    }
    totalPages = Math.ceil(slides.length / slidesPerView);
    if (currentIndex >= totalPages) currentIndex = totalPages - 1;
    renderDots();
    goTo(currentIndex);
  }

  function goTo(index: number) {
    currentIndex = index;
    const slideWidth = 100 / slidesPerView;
    const offset = currentIndex * slidesPerView * slideWidth;
    track.style.transform = `translateX(-${offset}%)`;
    updateDots();
  }

  function next() {
    goTo(currentIndex < totalPages - 1 ? currentIndex + 1 : 0);
  }

  function prev() {
    goTo(currentIndex > 0 ? currentIndex - 1 : totalPages - 1);
  }

  function renderDots() {
    dotsContainer.innerHTML = '';
    for (let i = 0; i < totalPages; i++) {
      const dot = document.createElement('button');
      dot.className = 'w-2.5 h-2.5 rounded-full transition-colors cursor-pointer';
      dot.setAttribute('aria-label', `Go to page ${i + 1}`);
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
    updateDots();
  }

  function updateDots() {
    dotsContainer.querySelectorAll('button').forEach((dot, i) => {
      if (i === currentIndex) {
        dot.className = 'w-2.5 h-2.5 rounded-full bg-[var(--color-brand-orange)] transition-colors cursor-pointer';
      } else {
        dot.className = 'w-2.5 h-2.5 rounded-full bg-[var(--color-surface-border)] transition-colors cursor-pointer';
      }
    });
  }

  function startAutoplay() {
    autoplayInterval = setInterval(next, 5000);
  }

  function resetAutoplay() {
    clearInterval(autoplayInterval);
    startAutoplay();
  }

  prevBtn?.addEventListener('click', () => { prev(); resetAutoplay(); });
  nextBtn?.addEventListener('click', () => { next(); resetAutoplay(); });

  track.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
  track.addEventListener('mouseleave', startAutoplay);

  // Touch/swipe support
  let touchStartX = 0;
  let touchEndX = 0;
  const swipeThreshold = 50;

  track.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
    clearInterval(autoplayInterval);
  }, { passive: true });

  track.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        next();
      } else {
        prev();
      }
    }
    startAutoplay();
  });

  updateSlidesPerView();
  startAutoplay();
  window.addEventListener('resize', updateSlidesPerView);
</script>
