---
import { appExamples } from '../data/site-content';

const iconPaths: Record<string, string> = {
  clock: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  user: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  clipboard: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
};
---

<section id="app-development" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-8">Custom App Development</h2>
    <div class="mb-8 max-w-3xl">
      <p class="text-lg text-[var(--color-text-secondary)]">
        Beyond websites, I identify existing technology and/or create custom applications that solve specific business problems, automate workflows, and provide tailored solutions for your unique challenges.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {appExamples.map((app) => (
        <div class="bg-[var(--color-surface-raised)] rounded-lg p-6 shadow-md border border-[var(--color-surface-border)] card-hover">
          <div class="text-center mb-4">
            <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-[var(--color-brand-orange)]/10 text-[var(--color-brand-orange)] mb-3">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[app.icon]} />
              </svg>
            </div>
            <h3 class="text-xl font-bold">{app.title}</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]">{app.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
