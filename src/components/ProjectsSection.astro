---
import { projects } from '../data/site-content';
---

<section id="projects" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 text-center">My Projects</h2>
    <p class="text-[var(--color-text-secondary)] mb-8 max-w-3xl mx-auto text-center">
      A selection of websites I've built for clients, organizations, and events. I've been shipping since 2017 — long before AI entered the picture. Want to see more of my work? Check out my <a href="https://jessepeplinski.com/projects" target="_blank" rel="noopener noreferrer" class="text-[var(--color-brand-orange)] underline hover:brightness-125 transition-all">personal site</a>.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover">
          <div class="aspect-video overflow-hidden">
            <a href={project.url} target="_blank" rel="noopener noreferrer">
              <img
                src={project.image}
                alt={`${project.name} screenshot`}
                class="w-full h-full object-cover hover:scale-105 hover:brightness-110 transition-transform duration-300"
              />
            </a>
          </div>
          <div class="p-4">
            <h3 class="text-lg font-bold mb-2">{project.name}</h3>
            <p class="text-[var(--color-text-secondary)] text-sm mb-3">{project.description}</p>
            <div class="flex justify-between items-center">
              <span class="text-xs text-[var(--color-text-muted)]">{project.date} · {project.buildTime}</span>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] text-white px-3 py-1 rounded-md text-sm font-medium hover:opacity-90 transition"
              >
                {project.cta}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
