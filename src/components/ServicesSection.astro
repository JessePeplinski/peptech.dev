---
const services = [
  {
    icon: 'globe',
    title: 'Websites',
    description: 'Professional marketing sites that serve as your digital front door. Responsive, fast, and built to convert visitors into customers.',
  },
  {
    icon: 'code',
    title: 'Custom Apps',
    description: 'Scheduling systems, customer portals, inventory management — tools built to solve your specific business problems and save you time.',
  },
  {
    icon: 'phone',
    title: 'Mobile Apps',
    description: 'Native or cross-platform apps for your customers and team. Put your business in their pocket.',
  },
];

const iconPaths: Record<string, string> = {
  globe: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  phone: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
};
---

<section id="services" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-12 text-center">What I Build</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="bg-[var(--color-surface)] rounded-lg p-6 shadow-md border border-[var(--color-surface-border)] card-hover">
          <div class="mb-4">
            <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-[var(--color-brand-orange)]/10 text-[var(--color-brand-orange)] mb-3">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.icon]} />
              </svg>
            </div>
            <h3 class="text-xl font-bold">{service.title}</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
