---
import { processSteps } from '../data/site-content';
---

<section id="process" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-12">My Process</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {processSteps.map((step) => (
        <div class="bg-[var(--color-surface-raised)] rounded-lg p-6 shadow-md border border-[var(--color-surface-border)] relative">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-[var(--color-brand-orange)] to-[var(--color-brand-burnt)] text-white h-8 w-8 rounded-full flex items-center justify-center text-lg font-bold">
            {step.number}
          </div>
          <h3 class="text-xl font-bold mb-3 mt-4 text-center">{step.title}</h3>
          <p class="text-[var(--color-text-secondary)]">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
