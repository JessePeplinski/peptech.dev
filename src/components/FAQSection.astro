---
import { faqs } from '../data/site-content';
---

<section id="faq" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-12 text-center">Frequently Asked Questions</h2>
    <div class="space-y-6">
      {faqs.map((faq) => (
        <div class="bg-[var(--color-surface-raised)] rounded-lg shadow-md border border-[var(--color-surface-border)] overflow-hidden">
          <button class="faq-toggle w-full text-left px-6 py-4 font-medium focus:outline-none flex justify-between items-center cursor-pointer">
            <span>{faq.question}</span>
            <svg class="faq-arrow h-5 w-5 shrink-0 ml-4 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-content px-6 pb-4 hidden">
            <p class="text-[var(--color-text-secondary)]">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const content = toggle.nextElementSibling as HTMLElement;
      const arrow = toggle.querySelector('.faq-arrow');

      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        arrow?.classList.add('open');
      } else {
        content.classList.add('hidden');
        arrow?.classList.remove('open');
      }
    });
  });
</script>
