---
---

<section id="intake" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-4 text-center">Work With Me</h2>
    <p class="text-[var(--color-text-secondary)] mb-8 max-w-3xl mx-auto text-center">
      Fill out the form below and I'll get back to you within 48 hours. If you're a first-time client, I typically recommend starting with a marketing site so you can see how I work — then we can determine your needs from there.
    </p>

    <form id="intake-form" class="space-y-6">
      <!-- Contact Info -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium mb-2">Name <span class="text-[var(--color-brand-orange)]">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors"
            placeholder="John Smith"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium mb-2">Email <span class="text-[var(--color-brand-orange)]">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors"
            placeholder="john@example.com"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="phone" class="block text-sm font-medium mb-2">Phone</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors"
            placeholder="(315) 555-1234"
          />
        </div>
        <div>
          <label for="website" class="block text-sm font-medium mb-2">Website <span class="text-[var(--color-text-muted)] text-xs">(if you have one)</span></label>
          <input
            type="url"
            id="website"
            name="website"
            class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors"
            placeholder="https://yourbusiness.com"
          />
        </div>
      </div>

      <div>
        <label for="hosting" class="block text-sm font-medium mb-2">Where is your site hosted? <span class="text-[var(--color-text-muted)] text-xs">(if applicable)</span></label>
        <select
          id="hosting"
          name="hosting"
          class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors cursor-pointer"
        >
          <option value="">Select a provider</option>
          <option value="godaddy">GoDaddy</option>
          <option value="squarespace">Squarespace</option>
          <option value="wix">Wix</option>
          <option value="wordpress">WordPress.com</option>
          <option value="shopify">Shopify</option>
          <option value="none">I don't have a website yet</option>
          <option value="not-sure">Not sure</option>
          <option value="other">Other</option>
        </select>
      </div>

      <!-- Business Description -->
      <div>
        <label for="business-description" class="block text-sm font-medium mb-2">
          Briefly describe your business <span class="text-[var(--color-brand-orange)]">*</span>
          <span class="text-[var(--color-text-muted)] text-xs ml-1">(what it is, who it serves — 200-400 words)</span>
        </label>
        <textarea
          id="business-description"
          name="business-description"
          required
          rows="6"
          class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y"
          placeholder="Pep Tech Solutions is a technology services company based in Central New York that helps small businesses solve problems with technology. We work with local mom and pop shops who don't have time to focus on their digital needs but understand that their online presence matters. We typically start by building a professional website, then grow into custom apps, automation, and SaaS solutions as trust is built..."
        ></textarea>
        <p class="text-xs text-[var(--color-text-muted)] mt-1"><span id="word-count">0</span> words</p>
      </div>

      <!-- Problems -->
      <div>
        <label class="block text-sm font-medium mb-2">
          What problems is your business facing? <span class="text-[var(--color-brand-orange)]">*</span>
          <span class="text-[var(--color-text-muted)] text-xs ml-1">(be as detailed as possible)</span>
        </label>
        <div class="space-y-4">
          <div>
            <label for="problem-1" class="block text-xs text-[var(--color-text-muted)] mb-1">Problem 1</label>
            <textarea
              id="problem-1"
              name="problem-1"
              required
              rows="3"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y"
              placeholder="e.g. We don't have a website and customers can't find us online..."
            ></textarea>
          </div>
          <div>
            <label for="problem-2" class="block text-xs text-[var(--color-text-muted)] mb-1">Problem 2</label>
            <textarea
              id="problem-2"
              name="problem-2"
              rows="3"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y"
              placeholder="e.g. We spend hours every week manually scheduling appointments..."
            ></textarea>
          </div>
          <div>
            <label for="problem-3" class="block text-xs text-[var(--color-text-muted)] mb-1">Problem 3</label>
            <textarea
              id="problem-3"
              name="problem-3"
              rows="3"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors resize-y"
              placeholder="e.g. Our inventory tracking is all done on paper and we keep losing track of stock..."
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <label class="block text-sm font-medium mb-2">What services are you looking for? <span class="text-[var(--color-brand-orange)]">*</span></label>
        <div class="space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="services" value="marketing-site" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-medium">Marketing Site</span>
              <p class="text-xs text-[var(--color-text-muted)]">A professional website to establish your online presence</p>
            </div>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="services" value="web-app" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-medium">Web App / SaaS</span>
              <p class="text-xs text-[var(--color-text-muted)]">A custom application to solve a specific business problem</p>
            </div>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="services" value="mobile-app" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-medium">Mobile App</span>
              <p class="text-xs text-[var(--color-text-muted)]">A native or cross-platform mobile application</p>
            </div>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="services" value="not-sure" class="mt-1 accent-[var(--color-brand-orange)] cursor-pointer" />
            <div>
              <span class="font-medium">Not sure yet</span>
              <p class="text-xs text-[var(--color-text-muted)]">Let's talk and figure out the best fit together</p>
            </div>
          </label>
        </div>
      </div>

      <!-- How did you hear about me -->
      <div>
        <label for="referral" class="block text-sm font-medium mb-2">How did you hear about me?</label>
        <select
          id="referral"
          name="referral"
          class="w-full px-4 py-3 rounded-lg bg-[var(--color-surface)] border border-[var(--color-surface-border)] text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-brand-orange)] transition-colors cursor-pointer"
        >
          <option value="">Select an option</option>
          <option value="google">Google</option>
          <option value="referral">Referral / Word of mouth</option>
          <option value="social-media">Social media</option>
          <option value="linkedin">LinkedIn</option>
          <option value="saw-my-work">Saw a website I built</option>
          <option value="other">Other</option>
        </select>
      </div>

      <button
        type="submit"
        class="btn-gradient w-full justify-center text-center"
      >
        Submit
      </button>
      <p class="text-center text-sm text-[var(--color-text-muted)] mt-3">
        Prefer email? Reach me at <a href="mailto:peplinski.jesse@gmail.com" class="text-[var(--color-brand-orange)] underline hover:brightness-125 transition-all">peplinski.jesse@gmail.com</a>
      </p>
    </form>

    <!-- Success message (hidden by default) -->
    <div id="form-success" class="hidden text-center py-12">
      <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-green-500/10 text-green-400 mb-4">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-2xl font-bold mb-2">Thanks!</h3>
      <p class="text-[var(--color-text-secondary)]">I'll review your submission and get back to you within 48 hours.</p>
    </div>
  </div>
</section>

<script>
  // Word counter for business description
  const desc = document.getElementById('business-description') as HTMLTextAreaElement;
  const wordCount = document.getElementById('word-count');
  desc?.addEventListener('input', () => {
    const words = desc.value.trim().split(/\s+/).filter(w => w.length > 0).length;
    if (wordCount) wordCount.textContent = String(words);
  });

  // Form submission
  const form = document.getElementById('intake-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: Wire up to a backend service (e.g., Formspree, Vercel serverless function, email API)
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
