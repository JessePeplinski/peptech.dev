<canvas class="code-bg-canvas"></canvas>

<style>
  .code-bg-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  function initCodeBackground() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>('.code-bg-canvas');
    canvases.forEach((canvas) => {
      const parent = canvas.parentElement;
      if (!parent || canvas.dataset.initialized) return;
      canvas.dataset.initialized = 'true';

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const chars = ['{', '}', '<', '>', '/>', '=>', ';', '::', '()', '[]', '//', '#', '$', '_', '|', '&&', '||', '**', '!=', '==='];

      interface Particle {
        char: string;
        x: number;
        y: number;
        fontSize: number;
        opacity: number;
        vx: number;
        vy: number;
        rotation: number;
        vRotation: number;
      }

      let particles: Particle[] = [];
      let animId: number;
      let isVisible = true;
      let mouseX = -1000;
      let mouseY = -1000;
      const REPEL_RADIUS = 120;
      const REPEL_STRENGTH = 2.5;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      function isDark(): boolean {
        return document.documentElement.classList.contains('dark');
      }

      function getColor(opacity: number): string {
        return `rgba(255, 165, 0, ${opacity})`;
      }

      function resize() {
        const dpr = window.devicePixelRatio || 1;
        const rect = parent!.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function createParticles() {
        const rect = parent!.getBoundingClientRect();
        const count = Math.max(15, Math.min(30, Math.floor(rect.width * rect.height / 25000)));
        particles = [];
        for (let i = 0; i < count; i++) {
          particles.push({
            char: chars[Math.floor(Math.random() * chars.length)],
            x: Math.random() * rect.width,
            y: Math.random() * rect.height,
            fontSize: 20 + Math.random() * 20,
            opacity: isDark() ? 0.2 + Math.random() * 0.15 : 0.15 + Math.random() * 0.1,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.2,
            rotation: Math.random() * Math.PI * 2,
            vRotation: (Math.random() - 0.5) * 0.003,
          });
        }
      }

      function draw() {
        const rect = parent!.getBoundingClientRect();
        ctx!.clearRect(0, 0, rect.width, rect.height);
        for (const p of particles) {
          ctx!.save();
          ctx!.translate(p.x, p.y);
          ctx!.rotate(p.rotation);
          ctx!.font = `${p.fontSize}px Inter, system-ui, sans-serif`;
          ctx!.fillStyle = getColor(p.opacity);
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';
          ctx!.fillText(p.char, 0, 0);
          ctx!.restore();
        }
      }

      function update() {
        const rect = parent!.getBoundingClientRect();
        for (const p of particles) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < REPEL_RADIUS && dist > 0) {
            const force = (1 - dist / REPEL_RADIUS) * REPEL_STRENGTH;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
            p.vRotation += (Math.random() - 0.5) * 0.01;
          }
          p.vx *= 0.97;
          p.vy *= 0.97;
          const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
          if (speed < 0.1) {
            p.vx += (Math.random() - 0.5) * 0.05;
            p.vy += (Math.random() - 0.5) * 0.05;
          }
          p.x += p.vx;
          p.y += p.vy;
          p.rotation += p.vRotation;
          p.vRotation *= 0.99;
          if (p.x < -20) p.x = rect.width + 20;
          if (p.x > rect.width + 20) p.x = -20;
          if (p.y < -20) p.y = rect.height + 20;
          if (p.y > rect.height + 20) p.y = -20;
        }
      }

      function loop() {
        if (!isVisible) return;
        update();
        draw();
        animId = requestAnimationFrame(loop);
      }

      resize();
      createParticles();
      if (reducedMotion.matches) {
        draw();
      } else {
        loop();
      }

      parent!.addEventListener('mousemove', (e) => {
        const rect = parent!.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      parent!.addEventListener('mouseleave', () => {
        mouseX = -1000;
        mouseY = -1000;
      });

      const ro = new ResizeObserver(() => {
        resize();
        if (reducedMotion.matches) draw();
      });
      ro.observe(parent!);

      const io = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry.isIntersecting;
          if (isVisible && !reducedMotion.matches) {
            cancelAnimationFrame(animId);
            loop();
          }
        },
        { threshold: 0 }
      );
      io.observe(parent!);

      const mo = new MutationObserver(() => {
        for (const p of particles) {
          p.opacity = isDark() ? 0.2 + Math.random() * 0.15 : 0.15 + Math.random() * 0.1;
        }
        if (reducedMotion.matches) draw();
      });
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

      reducedMotion.addEventListener('change', (e) => {
        if (e.matches) {
          cancelAnimationFrame(animId);
          draw();
        } else if (isVisible) {
          loop();
        }
      });
    });
  }

  initCodeBackground();
</script>
