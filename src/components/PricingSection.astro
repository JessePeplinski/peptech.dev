---
import { websiteBuild, websiteMonthly, appBuild, appMonthly, marketingPricing } from '../data/site-content';

const checkIcon = `<svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>`;
---

<section id="investment" class="py-16 bg-[var(--color-surface-raised)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold mb-6 text-center">Investment</h2>
    <div class="mb-8 max-w-3xl mx-auto text-center">
      <p class="text-lg text-[var(--color-text-secondary)]">
        Below are my standard packages designed for small businesses looking to boost efficiency, improve customer experience, and save time. Whether you need a website, a custom app, or a mobile app — I've got you covered.
      </p>
    </div>

    <!-- Tabs -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex rounded-md shadow-sm flex-wrap justify-center" role="group">
        <button type="button" id="websites-tab" class="service-tab active-tab py-2 px-4 text-sm font-medium bg-[var(--color-surface)] text-[var(--color-text-secondary)] border border-[var(--color-surface-border)] rounded-l-lg hover:bg-[var(--color-surface-raised)] transition cursor-pointer">
          Websites
        </button>
        <button type="button" id="apps-tab" class="service-tab py-2 px-4 text-sm font-medium bg-[var(--color-surface)] text-[var(--color-text-secondary)] border-t border-b border-[var(--color-surface-border)] hover:bg-[var(--color-surface-raised)] transition cursor-pointer">
          Custom Apps
        </button>
        <button type="button" id="marketing-tab" class="service-tab py-2 px-4 text-sm font-medium bg-[var(--color-surface)] text-[var(--color-text-secondary)] border border-[var(--color-surface-border)] hover:bg-[var(--color-surface-raised)] transition cursor-pointer">
          Marketing
        </button>
        <button type="button" id="mobile-tab" class="service-tab py-2 px-4 text-sm font-medium bg-[var(--color-surface)] text-[var(--color-text-secondary)] border-t border-b border-r border-[var(--color-surface-border)] rounded-r-lg hover:bg-[var(--color-surface-raised)] transition cursor-pointer">
          Mobile Apps
        </button>
      </div>
    </div>

    <!-- Websites Content -->
    <div id="websites-content" class="service-content">
      <!-- Step 1: One-time build -->
      <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover max-w-3xl mx-auto">
        <div class="p-6 md:p-8">
          <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-brand-orange)] mb-2">Step 1 — One-time</p>
          <h3 class="text-xl font-bold mb-2">{websiteBuild.name}</h3>
          <p class="text-3xl font-bold mb-4 gradient-text">{websiteBuild.price}</p>
          <p class="text-[var(--color-text-secondary)] mb-4">{websiteBuild.description}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
            {websiteBuild.features.map((feature) => (
              <div class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Connector -->
      <div class="flex flex-col items-center my-8">
        <div class="w-px h-8 bg-[var(--color-surface-border)]"></div>
        <p class="text-sm font-medium text-[var(--color-text-secondary)] my-3">Then choose a monthly plan</p>
        <svg class="w-6 h-6 text-[var(--color-brand-orange)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>

      <!-- Step 2: Monthly plans -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 max-w-3xl mx-auto">
        {websiteMonthly.map((pkg) => (
          <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover relative">
            {pkg.popular && (
              <div class="absolute top-0 right-0 bg-[var(--color-brand-orange)] text-white px-3 py-1 rounded-bl-lg text-xs font-bold">RECOMMENDED</div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-brand-orange)] mb-2">Step 2 — Monthly</p>
              <h3 class="text-xl font-bold mb-2">{pkg.name}</h3>
              <p class="text-3xl font-bold mb-4 gradient-text">{pkg.price}</p>
              <p class="text-[var(--color-text-secondary)] mb-4">{pkg.description}</p>
              <ul class="space-y-2">
                {pkg.features.map((feature) => (
                  <li class="flex items-start">
                    <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-[var(--color-text-muted)] mb-12 max-w-xl mx-auto">
        Example: Website Build + Growth = <span class="text-[var(--color-text-primary)] font-medium">$3,000</span> one-time + <span class="text-[var(--color-text-primary)] font-medium">$150/mo</span>
      </p>

    </div>

    <!-- Apps Content -->
    <div id="apps-content" class="service-content hidden">
      <!-- Step 1: One-time build -->
      <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover max-w-3xl mx-auto">
        <div class="p-6 md:p-8">
          <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-brand-orange)] mb-2">Step 1 — One-time</p>
          <h3 class="text-xl font-bold mb-2">{appBuild.name}</h3>
          <p class="text-3xl font-bold mb-4 gradient-text">{appBuild.price}</p>
          <p class="text-[var(--color-text-secondary)] mb-4">{appBuild.description}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-2">
            {appBuild.features.map((feature) => (
              <div class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>{feature}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Connector -->
      <div class="flex flex-col items-center my-8">
        <div class="w-px h-8 bg-[var(--color-surface-border)]"></div>
        <p class="text-sm font-medium text-[var(--color-text-secondary)] my-3">Then choose a monthly plan</p>
        <svg class="w-6 h-6 text-[var(--color-brand-orange)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>

      <!-- Step 2: Monthly plans -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 max-w-3xl mx-auto">
        {appMonthly.map((pkg) => (
          <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover relative">
            {pkg.popular && (
              <div class="absolute top-0 right-0 bg-[var(--color-brand-orange)] text-white px-3 py-1 rounded-bl-lg text-xs font-bold">RECOMMENDED</div>
            )}
            <div class="p-6">
              <p class="text-xs font-medium uppercase tracking-wide text-[var(--color-brand-orange)] mb-2">Step 2 — Monthly</p>
              <h3 class="text-xl font-bold mb-2">{pkg.name}</h3>
              <p class="text-3xl font-bold mb-4 gradient-text">{pkg.price}</p>
              <p class="text-[var(--color-text-secondary)] mb-4">{pkg.description}</p>
              <ul class="space-y-2">
                {pkg.features.map((feature) => (
                  <li class="flex items-start">
                    <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-[var(--color-text-muted)] mb-12 max-w-xl mx-auto">
        Example: Custom App Build + Growth = <span class="text-[var(--color-text-primary)] font-medium">$7,500+</span> one-time + <span class="text-[var(--color-text-primary)] font-medium">$300/mo</span>
      </p>

    </div>

    <!-- Mobile Apps Content -->
    <div id="mobile-content" class="service-content hidden">
      <div class="bg-[var(--color-surface)] rounded-lg p-8 shadow-md border border-[var(--color-surface-border)] max-w-3xl mx-auto">
        <h3 class="text-xl font-bold mb-2">Mobile App Development</h3>
        <p class="text-3xl font-bold mb-4 gradient-text">Custom quote</p>
        <p class="text-[var(--color-text-secondary)] mb-6">
          Mobile apps are scoped and priced based on your specific needs. Every project is different, so I prefer to understand your requirements before quoting a price.
        </p>
        <ul class="mb-8 space-y-2">
          <li class="flex items-start">
            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>iOS and Android support</span>
          </li>
          <li class="flex items-start">
            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Native or cross-platform development</span>
          </li>
          <li class="flex items-start">
            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Push notifications and offline support</span>
          </li>
          <li class="flex items-start">
            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>App Store and Google Play submission</span>
          </li>
          <li class="flex items-start">
            <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Integration with your existing systems</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Marketing Content -->
    <div id="marketing-content" class="service-content hidden">
      <div class="bg-[var(--color-surface)] rounded-lg overflow-hidden shadow-md border border-[var(--color-surface-border)] card-hover max-w-3xl mx-auto">
        <div class="p-6 md:p-8">
          <h3 class="text-xl font-bold mb-2">{marketingPricing.name}</h3>
          <p class="text-3xl font-bold mb-4 gradient-text">{marketingPricing.price}</p>
          <p class="text-[var(--color-text-secondary)] mb-4">{marketingPricing.description}</p>
          <ul class="space-y-2">
            {marketingPricing.features.map((feature) => (
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = ['websites', 'apps', 'mobile', 'marketing'];

  tabs.forEach(tab => {
    const btn = document.getElementById(`${tab}-tab`);
    btn?.addEventListener('click', () => {
      tabs.forEach(t => {
        document.getElementById(`${t}-tab`)?.classList.remove('active-tab');
        document.getElementById(`${t}-content`)?.classList.add('hidden');
      });
      btn.classList.add('active-tab');
      document.getElementById(`${tab}-content`)?.classList.remove('hidden');
    });
  });
</script>
